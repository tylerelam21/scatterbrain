# Copy to .env.local and fill in. Never commit the real file.

# Postgres (Neon or Supabase recommended — PRD §36)
DATABASE_URL="postgresql://user:password@host:5432/scatterbrain"

# Auth.js (PRD §9). Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Canonical app URL — used to build the Google sign-in callback and the
# separate Calendar-connect OAuth callback (PRD §13). Must match a
# registered redirect URI exactly, e.g. https://scatterbrain-topaz.vercel.app
AUTH_URL=""

# The only email allowed to sign in (PRD §9.1 — single-owner V1).
OWNER_EMAIL=""

# Application-level key used to encrypt CalendarConnection refresh/access
# tokens at rest (PRD §52) — must be separate from database credentials.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Authenticates Vercel Cron's calls to /api/cron/sync-calendars (see
# vercel.json). Set this in the Vercel project's env vars — Vercel then
# automatically signs its own cron requests with it as
# `Authorization: Bearer $CRON_SECRET`, so nobody else can trigger a sync.
# Generate with `openssl rand -hex 32`. Not needed for local dev.
# Also authenticates /api/cron/sync-github (same cron, same secret).
CRON_SECRET=""

# Optional. Raises GitHub's unauthenticated 60/hr rate limit for
# /api/cron/sync-github (lib/github/client.ts) — only worth setting once
# you've linked enough project repos that 60/hr becomes a real ceiling.
# A fine-grained PAT with no scopes is enough for public repos.
GITHUB_TOKEN=""

# Object storage for photos (PRD §26 — Cloudflare R2 or S3-compatible).
# The bucket is kept PRIVATE — photos are served through /api/photos/[id],
# which checks visibility before generating a short-lived signed URL, so
# there's no STORAGE_PUBLIC_URL (a public bucket would defeat that).
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""

# "Find the best move" (Today page) — a Lichess personal API token with the
# puzzle:read scope, used server-side only to fetch endgame puzzles.
# Generate one at https://lichess.org/account/oauth/token (check
# "puzzle:read" under Puzzles, no OAuth app registration needed). If unset,
# the section falls back to the most recently cached puzzle, or is skipped
# entirely if none exists yet.
LICHESS_API_TOKEN=""
