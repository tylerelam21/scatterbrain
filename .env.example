# Copy to .env.local and fill in. Never commit the real file.

# Postgres (Neon or Supabase recommended — PRD §36)
DATABASE_URL="postgresql://user:password@host:5432/scatterbrain"

# Auth.js (PRD §9). Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Canonical app URL — used to build the Google sign-in callback and the
# separate Calendar-connect OAuth callback (PRD §13). Must match a
# registered redirect URI exactly, e.g. https://scatterbrain-topaz.vercel.app
AUTH_URL=""

# The only email allowed to sign in (PRD §9.1 — single-owner V1).
OWNER_EMAIL=""

# Application-level key used to encrypt CalendarConnection refresh/access
# tokens at rest (PRD §52) — must be separate from database credentials.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Object storage for photos (PRD §26 — Cloudflare R2 or S3-compatible).
# The bucket is kept PRIVATE — photos are served through /api/photos/[id],
# which checks visibility before generating a short-lived signed URL, so
# there's no STORAGE_PUBLIC_URL (a public bucket would defeat that).
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
